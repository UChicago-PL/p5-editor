{
  "name": "CS 111 Editor",
  "description": "The CS 111 Editor is an in-browser editor for creative coding, specifically for writing p5.js sketches.",
  "repository": "https://github.com/processing/p5.js-web-editor",
  "logo": "https://p5js.org/assets/img/p5js.svg",
  "keywords": [
    "processing",
    "p5js",
    "p5.js"
  ],
  "addons": [],
  "env": {
    "API_URL": {
      "value": "/editor"
    },
    "GITLAB_URL": {
      "description": "The GitLab instance URL",
      "value": "placeholder"
    },
    "GITLAB_ID": {
      "description": "The GitLab Client Id for sign in with GitLab support",
      "value": "placeholder"
    },
    "GITLAB_SECRET": {
      "description": "The GitLab Client Secret",
      "value": "placeholder"
    },
    "NODE_ENV": {
      "value": "production"
    },
    "SESSION_SECRET": {
      "description": "A secret key for verifying the integrity of signed cookies.",
      "generator": "secret"
    }
  },
  "scripts": {
    "postdeploy": "MONGO_URL=$MONGO_URI npm run fetch-examples:prod"
  }
}
